<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name welcome.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <object class="AdwApplicationWindow" id="welcome_window">
    <property name="default-height">450</property>
    <property name="default-width">450</property>
    <property name="title">Journal</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwHeaderBar">
            <property name="css-classes">flat</property>
            <property name="show-end-title-buttons">True</property>
            <property name="show-start-title-buttons">True</property>
          </object>
        </child>
        <child>
          <object class="AdwStatusPage">
            <property name="description">Please select a directory in which to store your journal entries.</property>
            <property name="icon-name">folder-documents-symbolic</property>
            <property name="title">Welcome to Journal!</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkButton" id="file_picker">
                <property name="css-classes">pill suggested-action</property>
                <property name="halign">center</property>
                <property name="label">Select Folder...</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
