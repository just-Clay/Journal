<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name window.ui -->
  <requires lib="Adw" version="1.0"/>
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="JournalWindow" parent="AdwApplicationWindow">
    <property name="default-height">600</property>
    <property name="default-width">800</property>
    <property name="title" translatable="yes">Journal</property>
    <child>
      <object class="AdwOverlaySplitView" id="split_view">
        <!-- Main Content Area -->
        <property name="content">
          <object class="AdwNavigationPage">
            <property name="title" translatable="yes">Journal</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkStack" id="stack">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkStackPage" id="calendar_view">
                        <property name="child">
                          <object class="GtkBox">
                            <property name="hexpand">True</property>
                            <property name="orientation">vertical</property>
                            <property name="vexpand">True</property>
                            <child>
                              <object class="AdwHeaderBar">
                                <property name="css-classes">flat</property>
                                <property name="show-back-button">False</property>
                                <property name="show-start-title-buttons">False</property>
                                <child type="start">
                                  <object class="GtkToggleButton">
                                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create|bidirectional"/>
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                  </object>
                                </child>
                                <child type="title">
                                  <object class="GtkBox">
                                    <property name="css-classes">linked</property>
                                    <child type="start">
                                      <object class="GtkButton" id="prev_month">
                                        <property name="halign">start</property>
                                        <property name="icon-name">go-previous</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton">
                                        <property name="label">*Month Year*</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="next_month">
                                        <property name="icon-name">go-next</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-end">12</property>
                                <property name="margin-start">12</property>
                                <property name="margin-top">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Monday</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Tuesday</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Wednesday</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Thursday</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Friday</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Saturday</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="halign">center</property>
                                    <property name="hexpand">True</property>
                                    <property name="label">Sunday</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkGrid" id="calendar_grid">
                                <property name="column-homogeneous">True</property>
                                <property name="column-spacing">6</property>
                                <property name="hexpand">True</property>
                                <property name="margin-bottom">12</property>
                                <property name="margin-end">12</property>
                                <property name="margin-start">12</property>
                                <property name="margin-top">10</property>
                                <property name="row-homogeneous">True</property>
                                <property name="row-spacing">6</property>
                                <property name="vexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">calendar</property>
                        <property name="title">Calendar</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage" id="timeline_view">
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="AdwHeaderBar">
                                <property name="show-back-button">False</property>
                                <property name="show-start-title-buttons">False</property>
                                <property name="title-widget">
                                  <object class="AdwWindowTitle">
                                    <property name="title">Timeline</property>
                                  </object>
                                </property>
                                <child type="start">
                                  <object class="GtkToggleButton">
                                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create|bidirectional"/>
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkListBox"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">timeline</property>
                        <property name="title">Timeline</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage" id="search_view">
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="AdwHeaderBar">
                                <property name="title-widget">
                                  <object class="GtkSearchEntry"/>
                                </property>
                                <child type="start">
                                  <object class="GtkToggleButton">
                                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create|bidirectional"/>
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkListBox"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">search</property>
                        <property name="title">Search</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage" id="on_this_day_view">
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="AdwHeaderBar">
                                <property name="title-widget">
                                  <object class="AdwWindowTitle">
                                    <property name="title">*date*</property>
                                  </object>
                                </property>
                                <child type="start">
                                  <object class="GtkToggleButton">
                                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create|bidirectional"/>
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="hexpand">True</property>
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkListBox"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">on_this_day</property>
                        <property name="title">On This Day</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage" id="editor_view">
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="AdwHeaderBar">
                                <property name="css-classes">flat</property>
                                <property name="show-back-button">False</property>
                                <property name="show-start-title-buttons">False</property>
                                <property name="title-widget">
                                  <object class="AdwWindowTitle">
                                    <property name="title">*date*</property>
                                  </object>
                                </property>
                                <child type="start">
                                  <object class="GtkToggleButton">
                                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create|bidirectional"/>
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwOverlaySplitView" id="attachment_view">
                                <property name="content">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <object class="AdwClamp">
                                        <child>
                                          <object class="AdwHeaderBar">
                                            <property name="css-classes">flat</property>
                                            <property name="margin-end">6</property>
                                            <property name="margin-start">6</property>
                                            <property name="show-back-button">False</property>
                                            <property name="show-end-title-buttons">False</property>
                                            <property name="show-start-title-buttons">False</property>
                                            <property name="show-title">False</property>
                                            <child>
                                              <object class="GtkDropDown">
                                                <property name="model">
                                                  <object class="GtkStringList">
                                                    <items>
                                                      <item>Plain Text</item>
                                                      <item>Heading 1</item>
                                                      <item>Heading 2</item>
                                                      <item>Heading 3</item>
                                                      <item>Heading 4</item>
                                                      <item>Heading 5</item>
                                                      <item>Heading 6</item>
                                                    </items>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkToggleButton" id="bold_toggle">
                                                <property name="icon-name">format-text-bold</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkToggleButton" id="italics_toggle">
                                                <property name="icon-name">format-text-italic</property>
                                              </object>
                                            </child>
                                            <child type="end">
                                              <object class="GtkToggleButton">
                                                <property name="active" bind-source="attachment_view" bind-property="show-sidebar" bind-flags="bidirectional | sync-create">True</property>
                                                <property name="icon-name">sidebar-show-right-symbolic</property>
                                                <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow">
                                        <property name="vexpand">True</property>
                                        <child>
                                          <object class="AdwClamp">
                                            <property name="vexpand">True</property>
                                            <child>
                                              <object class="GtkTextView">
                                                <property name="accepts-tab">False</property>
                                                <property name="bottom-margin">12</property>
                                                <property name="css-classes">card</property>
                                                <property name="left-margin">12</property>
                                                <property name="right-margin">12</property>
                                                <property name="top-margin">12</property>
                                                <property name="margin-bottom">12</property>
                                                <property name="margin-end">12</property>
                                                <property name="margin-start">12</property>
                                                <property name="vexpand">True</property>
                                                <property name="wrap-mode">word-char</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <property name="sidebar">
                                  <object class="GtkBox">
                                    <property name="css-classes">background</property>
                                    <property name="hexpand">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <property name="vexpand">True</property>
                                    <property name="visible">true</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="css-classes">card</property>
                                        <property name="margin-bottom">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-top">6</property>
                                        <property name="orientation">vertical</property>
                                        <child>
                                          <object class="AdwHeaderBar">
                                            <property name="css-classes">flat</property>
                                            <property name="show-back-button">False</property>
                                            <property name="show-end-title-buttons">False</property>
                                            <property name="show-start-title-buttons">False</property>
                                            <property name="show-title">False</property>
                                            <child type="start">
                                              <object class="GtkLabel">
                                                <property name="label">Attachments</property>
                                                <property name="margin-start">12</property>
                                              </object>
                                            </child>
                                            <child type="end">
                                              <object class="GtkButton" id="add_attachment">
                                                <property name="icon-name">document-new</property>
                                                <property name="margin-end">12</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwCarousel">
                                            <property name="vexpand">True</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <property name="sidebar-position">end</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="name">editor</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="max-sidebar-width">220.0</property>
        <property name="min-sidebar-width">150.0</property>
        <property name="show-sidebar">true</property>
        <!-- Sidebar Area -->
        <property name="sidebar">
          <object class="AdwNavigationPage">
            <property name="title">Journal</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="valign">fill</property>
                <child>
                  <object class="AdwHeaderBar">
                    <property name="css-classes">flat</property>
                    <property name="show-back-button">False</property>
                    <property name="show-end-title-buttons">False</property>
                    <property name="show-start-title-buttons">False</property>
                    <property name="show-title">True</property>
                    <property name="title-widget">
                      <object class="AdwWindowTitle">
                        <property name="title">Journal</property>
                      </object>
                    </property>
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="halign">center</property>
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="calendar_button">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">x-office-calendar</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="hexpand">true</property>
                            <property name="label">Calendar</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="halign">fill</property>
                    <property name="has-frame">False</property>
                    <property name="margin-bottom">2</property>
                    <property name="margin-end">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-top">2</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="timeline_button">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">view-list-bullet-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="hexpand">true</property>
                            <property name="label">Timeline</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="halign">fill</property>
                    <property name="has-frame">False</property>
                    <property name="margin-bottom">2</property>
                    <property name="margin-end">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-top">2</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="on_this_day_button">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="halign">fill</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">document-open-recent-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="hexpand">true</property>
                            <property name="label">On This Day</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="halign">fill</property>
                    <property name="has-frame">False</property>
                    <property name="margin-bottom">2</property>
                    <property name="margin-end">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-top">2</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="search_button">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">system-search</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="hexpand">true</property>
                            <property name="label">Search</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="halign">fill</property>
                    <property name="has-frame">False</property>
                    <property name="margin-bottom">2</property>
                    <property name="margin-end">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-top">2</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="sidebar-width-fraction">0.25</property>
      </object>
    </child>
  </template>
  <menu id="primary_menu">
    <item>
      <attribute name="action">app.preferences</attribute>
      <attribute name="label">Preferences</attribute>
    </item>
    <item>
      <attribute name="action">app.about</attribute>
      <attribute name="label">About Journal</attribute>
    </item>
  </menu>
</interface>
