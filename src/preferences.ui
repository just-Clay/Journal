<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name preferences.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <object class="AdwPreferencesWindow" id="preferences_window">
    <property name="default-height">500</property>
    <property name="default-width">300</property>
    <property name="search-enabled">False</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="name">preferences</property>
        <property name="title">Preferences</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="halign">center</property>
            <child>
              <object class="AdwActionRow" id = "folder_location_title">
                <property name="subtitle-selectable">True</property>
                <property name="halign">center</property>
                <property name="subtitle">No Location Selected</property>
                <property name="title">File Location</property>
                <child>
                  <object class="GtkButton" id="file_picker">
                    <property name="icon-name">folder-documents-symbolic</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-start">20</property>
                    <property name="margin-top">5</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
